# Copy to .env and fill in. Never commit real values.

DATABASE_URL=postgresql://fathom:fathom@localhost:5432/fathom
REDIS_URL=redis://127.0.0.1:6379
# Unused: sessions are opaque random ids stored in Redis (sess:*), not signed JWTs.
SESSION_SECRET=
# Host (and port) the SIWE message must name. Production: noxsea.xyz. Defaults to WEB_ORIGIN's host.
SIWE_DOMAIN=localhost:3000
# Secure flag on the session cookie. Defaults to true when NODE_ENV=production, false otherwise.
COOKIE_SECURE=

# Robinhood Chain. Verify every value against Robinhood's official docs before use.
# Public chain registries list the testnet as chain ID 46630,
# RPC https://rpc.testnet.chain.robinhood.com/rpc,
# explorer https://explorer.testnet.chain.robinhood.com
CHAIN_ID=
CHAIN_NAME=Robinhood Chain
RPC_URL=
EXPLORER_URL=
# Official USDG address from Robinhood's docs (do not copy from the prototype)
USDG_ADDRESS=

# Deployed contracts (leave empty until deployed; /trust shows "Not deployed yet")
CREDIT_VAULT_ADDRESS=
SWAP_ROUTER_ADDRESS=
FTHM_ADDRESS=
STAKING_ADDRESS=
INDEXER_CONFIRMATIONS=3

# Inference preset: mock (local dev/tests), openai-compatible (generic, needs INFERENCE_BASE_URL),
# or a named provider preset from apps/api/src/inference/presets.ts (e.g. tinfoil).
# Empty = chat disabled and every model reported unavailable.
INFERENCE_PROVIDER=
# Overrides the preset's base URL, e.g. https://provider.example/v1
INFERENCE_BASE_URL=
INFERENCE_API_KEY=
# JSON map of our model ids to provider ids; overrides/extends the preset map. Keep the single quotes
# (deploy.sh sources this file with bash), e.g.
# INFERENCE_MODEL_MAP='{"llama-3.3-70b":"meta-llama/Llama-3.3-70B-Instruct"}'
# Under a named preset, unmapped models are unavailable.
INFERENCE_MODEL_MAP=
# Server-side web search (user IPs never reach the search engine). Empty = web search unavailable.
BRAVE_SEARCH_API_KEY=
PLAUSIBLE_DOMAIN=

# WalletConnect (mobile wallets such as Robinhood Wallet via QR). Free project id from https://cloud.reown.com.
# Baked into the web build: redeploy after changing it. Empty = WalletConnect option hidden.
NEXT_PUBLIC_WC_PROJECT_ID=

# API server. In production PM2 pins the API to 127.0.0.1:4200 (the web app proxies /api there).
API_PORT=4200
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
