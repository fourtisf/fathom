# Copy to .env and fill in. Never commit real values.

DATABASE_URL=postgresql://fathom:fathom@localhost:5432/fathom
REDIS_URL=redis://127.0.0.1:6379
# Unused: sessions are opaque random ids stored in Redis (sess:*), not signed JWTs.
SESSION_SECRET=
# Host (and port) the SIWE message must name. Production: noxsea.xyz. Defaults to WEB_ORIGIN's host.
SIWE_DOMAIN=localhost:3000
# Secure flag on the session cookie. Defaults to true when NODE_ENV=production, false otherwise.
COOKIE_SECURE=

# Robinhood Chain. Verify every value against Robinhood's official docs before use
# (check the RPC with eth_chainId: mainnet must answer 0x1237 = 4663).
# Mainnet (per public chain registries): chain ID 4663, RPC https://rpc.mainnet.chain.robinhood.com,
# explorer https://robinhoodchain.blockscout.com. The public RPC is rate-limited.
# Testnet: chain ID 46630, RPC https://rpc.testnet.chain.robinhood.com/rpc,
# explorer https://explorer.testnet.chain.robinhood.com
CHAIN_ID=
CHAIN_NAME="Robinhood Chain"
RPC_URL=
EXPLORER_URL=
# Official USDG address from Robinhood's docs (do not copy from the prototype)
USDG_ADDRESS=

# USDG top-ups: users transfer USDG straight to this treasury address (use the multisig) and the API
# credits the sending wallet (1 USDG = 100 credits). Enabled only when CHAIN_ID, RPC_URL, USDG_ADDRESS
# and TREASURY_ADDRESS are all set and valid. An in-process indexer (every 15s) also picks up transfers.
TREASURY_ADDRESS=
# Confirmations before a top-up is credited. Default: INDEXER_CONFIRMATIONS, else 3.
TOPUP_CONFIRMATIONS=
# Minimum top-up in USDG (smaller transfers are not credited). Default 1.
TOPUP_MIN_USD=1
# First block the indexer scans when it has no saved position (Redis indexer:lastBlock).
# Default: latest block - 5000. Set it to the block where the treasury started receiving.
TOPUP_START_BLOCK=

# Deployed contracts (leave empty until deployed; /trust shows "Not deployed yet")
CREDIT_VAULT_ADDRESS=
SWAP_ROUTER_ADDRESS=
# Token contract address (CA). Leave empty to show "CA: Coming soon" on the site. Must be a valid 0x address;
# a malformed value is ignored. The site reads it at build time, so redeploy after setting it.
TOKEN_ADDRESS=
STAKING_ADDRESS=
INDEXER_CONFIRMATIONS=3

# Inference preset: mock (local dev/tests), openai-compatible (generic, needs INFERENCE_BASE_URL),
# or a named provider preset from apps/api/src/inference/presets.ts: tinfoil (confidential computing),
# openrouter (router, no TEE; restricted to no-data-collection / zero-retention upstreams).
# Empty = chat disabled and every model reported unavailable.
INFERENCE_PROVIDER=
# Overrides the preset's base URL, e.g. https://provider.example/v1
INFERENCE_BASE_URL=
INFERENCE_API_KEY=
# JSON map of our model ids to provider ids; overrides/extends the preset map. Keep the single quotes
# (optional; the value may also be written without them), e.g.
# INFERENCE_MODEL_MAP='{"llama-3.3-70b":"meta-llama/Llama-3.3-70B-Instruct"}'
# Under a named preset, unmapped models are unavailable.
INFERENCE_MODEL_MAP=
# JSON merged into each chat request, replacing the preset's default. For openrouter the default is
# '{"provider":{"data_collection":"deny","zdr":true},"usage":{"include":true}}'. Keep the single quotes.
INFERENCE_EXTRA_BODY=
# Welcome credits (25 per new wallet) anti-abuse. Activity check: the wallet must have sent a tx or
# hold native balance on CHAIN_ID (needs RPC_URL). Set to false to skip it.
WELCOME_REQUIRE_ACTIVITY=true
# Max welcome grants per client IP per UTC day, and in total per UTC day.
WELCOME_PER_IP_DAY=3
WELCOME_DAILY_CAP=300
# Secret salt for every IP-derived key (welcome and sign-in rate limits hash IPs with it; keys expire
# within 48h; raw IPs are never stored). Empty = a random salt kept in Redis (ip:salt). openssl rand -hex 32
WELCOME_SALT=

# Optional Cloudflare Turnstile on sign-in (/auth/verify). Both keys needed; the web app reads the
# site key from GET /config at runtime (no rebuild). Empty secret = no captcha. Agents using
# POST /v1/auth/siwe are not challenged.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-side web search (user IPs never reach the search engine). Empty = web search unavailable.
BRAVE_SEARCH_API_KEY=
PLAUSIBLE_DOMAIN=

# WalletConnect (mobile wallets such as Robinhood Wallet via QR). Free project id from https://cloud.reown.com.
# Baked into the web build: redeploy after changing it. Empty = WalletConnect option hidden.
NEXT_PUBLIC_WC_PROJECT_ID=

# API server. In production PM2 pins the API to 127.0.0.1:4200 (the web app proxies /api there).
API_PORT=4200
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
