{
  "name": "@fathom/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "validate": "dotenv -e ../../.env -- prisma validate",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "dotenv-cli": "^11.0.0"
  }
}
