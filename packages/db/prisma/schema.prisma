// Fathom database schema (CLAUDE.md §4).
// Credits are integer micro-credits (1 credit = 1,000,000). No readable chat content is ever stored.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TxType {
  WELCOME_BONUS
  TOPUP
  STAKE
  UNSTAKE
}

enum TxStatus {
  PENDING
  CONFIRMED
  FAILED
}

model User {
  id           String           @id @default(cuid())
  address      String           @unique // lowercase
  creditsMicro BigInt           @default(0)
  settings     Json             @default("{\"saveHistory\":true,\"defaultBurn\":\"off\",\"webSearch\":false}")
  createdAt    DateTime         @default(now())
  apiKeys      ApiKey[]
  txs          Transaction[]
  usage        UsageDaily[]
  chats        EncryptedChat[]
  shares       SharedChat[]
  memory       EncryptedMemory?
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String // e.g. "fth_live_ab12cd" shown in UI
  hash       String    @unique // sha256 of full key; full key never stored
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  // Set for short-lived agent session keys (POST /v1/auth/siwe); invalid after this time.
  expiresAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transaction {
  id           String   @id @default(cuid())
  userId       String
  type         TxType
  token        String? // USDG | USDC | ETH
  amountPaid   String? // decimal string in token units
  creditsMicro BigInt   @default(0)
  // Null for WELCOME_BONUS; Postgres unique allows multiple NULLs.
  txHash       String?  @unique
  status       TxStatus
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, type])
}

// Aggregates only, never content.
model UsageDaily {
  userId       String
  day          DateTime @db.Date
  model        String
  messages     Int      @default(0)
  creditsMicro BigInt   @default(0)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, model])
}

// Only if the user enabled history. Encrypted client-side; the server cannot read it.
model EncryptedChat {
  id         String    @id @default(cuid())
  userId     String
  ciphertext Bytes
  iv         Bytes
  burnAt     DateTime? // cron deletes rows past burnAt
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([burnAt])
}

// A chat the user chose to share. Encrypted in the browser with a random key that lives only in the
// link's #fragment (never sent to the server), so the server stores ciphertext it cannot read.
model SharedChat {
  id         String   @id // 22-char random, URL-safe
  userId     String
  ciphertext Bytes
  iv         Bytes
  createdAt  DateTime @default(now())
  expiresAt  DateTime // cron deletes rows past expiresAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Private memory: facts the user wants the AI to know, encrypted in their browser with the
/// wallet-derived history key. The server stores only ciphertext it cannot read.
model EncryptedMemory {
  userId     String   @id
  ciphertext Bytes
  iv         Bytes
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
